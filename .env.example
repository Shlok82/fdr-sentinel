# ==============================================================================
# FDR Sentinel - Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# Application Environment Mode (development | staging | production)
# Default when unset is 'production' (fail-safe principle)
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# Demo Credentials Panel on /login (renders ONLY when DEMO_MODE=true, DEMO_SHOW_CREDENTIALS=true, and APP_ENV!=production)
DEMO_SHOW_CREDENTIALS=false

# Application Host and Port
APP_HOST=0.0.0.0
APP_PORT=8000

# Security Secrets (Must be configured with real random keys in non-development modes)
# SECRET_KEY: random 48+ chars (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=REPLACE_ME

# DOCUMENT_MASTER_KEY: 32 random bytes, base64 (e.g. python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
DOCUMENT_MASTER_KEY=REPLACE_ME

# Seeding Secret (Used strictly by scripts/seed_users.py; must be >= 12 chars)
SEED_PASSWORD=REPLACE_ME

# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fdr_sentinel

# Database Owner Role (Used for schema migrations, Alembic, and seeding)
POSTGRES_USER=fdr_owner
POSTGRES_PASSWORD=fdr_owner_dev_password
DATABASE_OWNER_URL=postgresql+psycopg://fdr_owner:fdr_owner_dev_password@db:5432/fdr_sentinel

# Database Runtime Role (Used by FastAPI with revoked UPDATE/DELETE on audit_log)
POSTGRES_APP_USER=fdr_app_user
POSTGRES_APP_PASSWORD=fdr_app_dev_password
DATABASE_URL=postgresql+psycopg://fdr_app_user:fdr_app_dev_password@db:5432/fdr_sentinel

# Test Database URLs (Used for isolated test runs, non-secret placeholder)
TEST_OWNER_DATABASE_URL=postgresql+psycopg://fdr_owner:fdr_owner_dev_password@db:5432/fdr_sentinel_test
TEST_DATABASE_URL=postgresql+psycopg://fdr_app_user:fdr_app_dev_password@db:5432/fdr_sentinel_test

# Document Storage Path
UPLOAD_STORAGE_PATH=/app/storage

# Temporal Engine & Scheduler Automation (Tier 2)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
EXPIRING_WINDOW_DAYS=90
REMINDER_THRESHOLDS_DAYS=90,60,30,7
TIER2_MAX_DAYS=30
URGENT_MAX_DAYS=7
OVERDUE_ESCALATION_DAYS=15
PENDING_REVIEW_ALERT_DAYS=7
UNRESOLVED_FLAG_ALERT_DAYS=14
