# ==============================================================================
# FDR Sentinel - Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# Application Environment Mode
ENVIRONMENT=development
DEBUG=True
DEMO_MODE=True

# Application Host and Port
APP_HOST=0.0.0.0
APP_PORT=8000

# Security Secrets (Generate random 32+ char strings in production)
SECRET_KEY=change_me_to_a_secure_random_string_min_32_characters_long
DOCUMENT_MASTER_KEY=k8T0a7Z3Yx9L1q4W7e2R5t8Y1u4I7o0P3s6D9f2G5h8=

# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fdr_sentinel

# Database Owner Role (Used for schema migrations, Alembic, and seeding)
POSTGRES_USER=fdr_owner
POSTGRES_PASSWORD=fdr_owner_dev_password
DATABASE_OWNER_URL=postgresql+psycopg://fdr_owner:fdr_owner_dev_password@db:5432/fdr_sentinel

# Database Runtime Role (Used by FastAPI with revoked UPDATE/DELETE on audit_log)
POSTGRES_APP_USER=fdr_app_user
POSTGRES_APP_PASSWORD=fdr_app_dev_password
DATABASE_URL=postgresql+psycopg://fdr_app_user:fdr_app_dev_password@db:5432/fdr_sentinel

# Document Storage Path
UPLOAD_STORAGE_PATH=/app/storage
