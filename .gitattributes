# Auto detect text files and force LF line endings
* text=auto eol=lf

# Explicitly ensure shell scripts and configs are LF
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
